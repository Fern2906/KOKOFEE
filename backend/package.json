{
  "name": "kokofee-backend",
  "version": "1.0.0",
  "description": "API REST de KOKOFEE con Express, TypeScript y MongoDB",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
